<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/qw_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <!-- Seismograph Logo Graphic -->
    <ImageView
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:src="@drawable/ic_launcher_foreground"
        android:background="@drawable/bg_magnitude_badge"
        android:backgroundTint="@color/qw_primary_container"
        android:contentDescription="@string/app_name"
        android:padding="8dp" />

    <!-- Wordmark in Serif 28sp Bold -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xxl"
        android:text="@string/app_name"
        android:textSize="32sp"
        android:textColor="@color/qw_text_primary"
        android:fontFamily="serif"
        android:textStyle="bold" />

    <!-- Tagline -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:text="@string/tagline"
        android:textSize="@dimen/text_body"
        android:textColor="@color/qw_text_secondary"
        android:fontFamily="sans-serif" />

</LinearLayout>

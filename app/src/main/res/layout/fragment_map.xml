<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/qw_background">

    <!-- 1. The full-screen osmdroid MapView -->
    <org.osmdroid.views.MapView
        android:id="@+id/map_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 2. Header Bar with Title and Quake Count Pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/spacing_xl"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/spacing_sm">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_card_border"
            android:backgroundTint="@color/qw_surface"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:elevation="4dp">

            <TextView
                style="@style/QW.Text.ScreenTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:text="@string/nav_map" />

            <TextView
                android:id="@+id/tv_map_subtitle"
                style="@style/QW.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Showing recent epicenters" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3. Severity Legend in Top-Right Corner -->
    <com.google.android.material.card.MaterialCardView
        style="@style/QW.Card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="86dp"
        android:layout_marginEnd="@dimen/screen_padding"
        app:cardElevation="4dp"
        app:contentPadding="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/QW.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Severity"
                android:textStyle="bold" />

            <!-- Major >= 6.0 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_indicator_dot_active"
                    android:backgroundTint="@color/qw_sev_major" />

                <TextView
                    style="@style/QW.Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Major (\u22656)" />
            </LinearLayout>

            <!-- Strong 5.0 - 5.9 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_indicator_dot_active"
                    android:backgroundTint="@color/qw_sev_strong" />

                <TextView
                    style="@style/QW.Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Strong (5\u20135.9)" />
            </LinearLayout>

            <!-- Moderate 4.0 - 4.9 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_indicator_dot_active"
                    android:backgroundTint="@color/qw_sev_moderate" />

                <TextView
                    style="@style/QW.Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Moderate (4\u20134.9)" />
            </LinearLayout>

            <!-- Low < 4.0 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_indicator_dot_active"
                    android:backgroundTint="@color/qw_sev_low" />

                <TextView
                    style="@style/QW.Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Low (&lt;4)" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 4. Floating "Locate Me" Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_locate_me"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/screen_padding"
        android:layout_marginBottom="110dp"
        android:backgroundTint="@color/qw_surface"
        android:contentDescription="Locate me"
        app:elevation="4dp"
        app:fabSize="normal"
        app:rippleColor="@color/qw_ripple"
        app:srcCompat="@drawable/ic_location"
        app:tint="@color/qw_primary" />

    <!-- 5. Attribution Text at Bottom -->
    <TextView
        android:id="@+id/tv_map_attribution"
        style="@style/QW.Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#A0FFFDF9"
        android:gravity="center"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:text="Map data \u00A9 OpenStreetMap contributors"
        android:textColor="@color/qw_text_tertiary"
        android:textSize="10sp" />

    <!-- 6. Bottom Preview Card (Shows when a marker is tapped) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_bottom_preview"
        style="@style/QW.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginEnd="@dimen/screen_padding"
        android:layout_marginBottom="24dp"
        android:visibility="gone"
        app:cardElevation="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Magnitude Badge -->
                <TextView
                    android:id="@+id/tv_preview_magnitude"
                    android:layout_width="@dimen/mag_badge_size"
                    android:layout_height="@dimen/mag_badge_size"
                    android:background="@drawable/bg_magnitude_badge"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:text="5.4"
                    android:textColor="@color/qw_on_primary"
                    android:textSize="@dimen/mag_badge_text"
                    android:textStyle="bold" />

                <!-- Place and Time info -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_preview_place"
                        style="@style/QW.Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Near Tonga"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_preview_country"
                        style="@style/QW.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:textColor="@color/qw_primary"
                        android:textStyle="bold"
                        android:text="Country: English Name" />

                    <TextView
                        android:id="@+id/tv_preview_meta"
                        style="@style/QW.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="2 hours ago \u2022 depth 10 km" />
                </LinearLayout>

                <!-- Close Button -->
                <ImageView
                    android:id="@+id/btn_close_preview"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="4dp"
                    android:src="@drawable/ic_back"
                    android:rotation="270"
                    app:tint="@color/qw_text_tertiary"
                    android:contentDescription="Close preview" />
            </LinearLayout>

            <!-- View Details Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_preview_view_details"
                style="@style/QW.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:text="View details" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp">

    <!-- 1. User Message Container (Aligned Right) -->
    <LinearLayout
        android:id="@+id/layout_user_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_user_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:background="@drawable/bg_magnitude_badge"
            android:backgroundTint="@color/qw_primary"
            android:fontFamily="sans-serif"
            android:lineSpacingMultiplier="1.2"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:textColor="@color/qw_on_primary"
            android:textSize="15sp"
            tools:text="What should I do during an earthquake?" />
    </LinearLayout>

    <!-- 2. Assistant Message Container (Aligned Left) -->
    <LinearLayout
        android:id="@+id/layout_assistant_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:id="@+id/tv_assistant_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="48dp"
            android:background="@drawable/bg_magnitude_badge"
            android:backgroundTint="@color/qw_surface_variant"
            android:fontFamily="sans-serif"
            android:lineSpacingMultiplier="1.2"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:textColor="@color/qw_text_primary"
            android:textSize="15sp"
            tools:text="Drop, Cover, and Hold On! Get under a sturdy piece of furniture and stay away from glass windows." />

        <!-- Response Time / Thinking Caption -->
        <TextView
            android:id="@+id/tv_response_caption"
            style="@style/QW.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:textColor="@color/qw_text_tertiary"
            android:textSize="11sp"
            tools:text="Response time: 2.1 s" />
    </LinearLayout>

</LinearLayout>

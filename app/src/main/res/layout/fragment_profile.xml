<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/qw_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingTop="@dimen/spacing_xl"
        android:paddingBottom="@dimen/spacing_xxxl">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_profile"
            style="@style/QW.Text.ScreenTitle" />

        <TextView
            style="@style/QW.Text.BodySecondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Account identity, seismic alerts &amp; preferences" />

        <!-- 1. User Identity Header Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/QW.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/card_padding">

                <!-- Circular Avatar with Initials -->
                <TextView
                    android:id="@+id/tv_avatar"
                    android:layout_width="@dimen/avatar_size"
                    android:layout_height="@dimen/avatar_size"
                    android:background="@drawable/bg_magnitude_badge"
                    android:backgroundTint="@color/qw_primary_container"
                    android:gravity="center"
                    android:text="U"
                    android:textColor="@color/qw_primary"
                    android:textSize="18sp"
                    android:fontFamily="serif"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_lg"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_profile_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="QuakeWatch User"
                        style="@style/QW.Text.SectionTitle" />

                    <TextView
                        android:id="@+id/tv_profile_email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="user@example.com"
                        style="@style/QW.Text.Caption" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. Region Preference Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_region_setting"
            style="@style/QW.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/card_padding">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_location"
                    app:tint="@color/qw_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/QW.Text.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Monitoring Region"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tv_selected_region"
                        style="@style/QW.Text.BodySecondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="South Asia"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    style="@style/QW.Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Change"
                    android:textColor="@color/qw_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. Alert Notifications & Background Polling Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/QW.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_notifications"
                        app:tint="@color/qw_primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/QW.Text.SectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Earthquake Alerts"
                            android:textSize="16sp" />

                        <TextView
                            style="@style/QW.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Periodic background check every 15 mins" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_alerts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="@color/qw_primary"
                        app:trackTint="@color/qw_primary_container" />
                </LinearLayout>

                <!-- Magnitude Threshold Slider Section -->
                <LinearLayout
                    android:id="@+id/layout_alert_threshold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/qw_border" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/QW.Text.Label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Alert Threshold"
                            android:textColor="@color/qw_text_primary" />

                        <TextView
                            android:id="@+id/tv_alert_magnitude_value"
                            style="@style/QW.Text.SectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="M5.0+"
                            android:textColor="@color/qw_primary"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/slider_magnitude"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:stepSize="0.5"
                        android:value="5.0"
                        android:valueFrom="4.0"
                        android:valueTo="7.0"
                        app:haloColor="@color/qw_primary_container"
                        app:thumbColor="@color/qw_primary"
                        app:trackColorActive="@color/qw_primary"
                        app:trackColorInactive="@color/qw_surface_variant" />

                    <TextView
                        style="@style/QW.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="You will be notified for tremors at or above this magnitude" />
                </LinearLayout>

                <!-- Send Test Alert Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_test_alert"
                    style="@style/QW.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="16dp"
                    android:text="Send test alert"
                    android:textSize="13sp"
                    app:icon="@drawable/ic_notifications"
                    app:iconSize="16dp" />

                <TextView
                    style="@style/QW.Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="6dp"
                    android:text="Dispatches an immediate sample alert for demonstration"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 4. About / Credits Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/QW.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="About QuakeWatch"
                    style="@style/QW.Text.SectionTitle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:lineSpacingExtra="3dp"
                    android:text="Data Source: USGS Earthquake Hazards Program (QuakeML)\nMap Tiles: OpenStreetMap contributors &amp; CARTO\nAI Intelligence: Google Gemini 3.5 Flash\nAcademic Project: Mobile Application Development (Akash)\nVersion: 1.0 (Build 2026)"
                    style="@style/QW.Text.BodySecondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 5. Sign Out Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_sign_out"
            style="@style/QW.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/spacing_xl"
            android:text="Sign out"
            android:textColor="@color/qw_error"
            app:strokeColor="@color/qw_error" />

    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipe_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/qw_background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingTop="@dimen/spacing_lg"
            android:paddingBottom="@dimen/spacing_xxxl">

            <!-- 1. Header Row: Greeting, Name, Region & Avatar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_greeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Good day,"
                        style="@style/QW.Text.Caption" />

                    <TextView
                        android:id="@+id/tv_user_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="QuakeWatch"
                        style="@style/QW.Text.ScreenTitle" />

                    <TextView
                        android:id="@+id/tv_region_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="South Asia \u2022 Last 30 days"
                        style="@style/QW.Text.Caption" />
                </LinearLayout>

                <!-- Circular Avatar with Initials -->
                <TextView
                    android:id="@+id/tv_header_avatar"
                    android:layout_width="@dimen/avatar_size"
                    android:layout_height="@dimen/avatar_size"
                    android:background="@drawable/bg_magnitude_badge"
                    android:backgroundTint="@color/qw_primary_container"
                    android:gravity="center"
                    android:text="Q"
                    android:textColor="@color/qw_primary"
                    android:textSize="18sp"
                    android:fontFamily="serif"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless" />
            </LinearLayout>

            <!-- 2. Offline Banner -->
            <LinearLayout
                android:id="@+id/banner_offline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:background="@drawable/bg_chip"
                android:backgroundTint="@color/qw_surface_variant"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_cloud_off"
                    android:tint="@color/qw_text_secondary"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tv_offline_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="You are offline. Showing saved data"
                    style="@style/QW.Text.Caption" />
            </LinearLayout>

            <!-- 3. Hero Card: "Latest earthquake" -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="Latest recorded earthquake"
                style="@style/QW.Text.Label" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_hero"
                style="@style/QW.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Big Magnitude Badge -->
                        <TextView
                            android:id="@+id/tv_hero_badge"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/bg_magnitude_badge"
                            android:gravity="center"
                            android:text="5.4"
                            android:textColor="@color/qw_on_primary"
                            android:textSize="26sp"
                            android:fontFamily="serif"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_md"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/QW.Text.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="LATEST DETECTED EVENT"
                                android:textColor="@color/qw_primary"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_hero_place"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:text="12 km ESE of Baculin, Philippines"
                                style="@style/QW.Text.SectionTitle" />

                            <TextView
                                android:id="@+id/tv_hero_details"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="10 min ago \u2022 79 km deep"
                                style="@style/QW.Text.Caption" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_hero_view_details"
                        style="@style/QW.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:text="View event details" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. Stat Cards (2x2 Grid) -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:columnCount="2"
                android:rowCount="2"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false">

                <!-- Stat 1: Today -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/QW.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Today"
                                style="@style/QW.Text.Caption" />

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_notifications"
                                app:tint="@color/qw_text_secondary"
                                android:contentDescription="@null" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_stat_today_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="0"
                            style="@style/QW.Text.StatNumber" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Stat 2: Strongest -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/QW.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Strongest"
                                style="@style/QW.Text.Caption" />

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_trending_up"
                                app:tint="@color/qw_primary"
                                android:contentDescription="@null" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_stat_strongest"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="M --"
                            style="@style/QW.Text.StatNumber" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Stat 3: Average Depth -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/QW.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Avg. depth"
                                style="@style/QW.Text.Caption" />

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_location"
                                app:tint="@color/qw_text_secondary"
                                android:contentDescription="@null" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_stat_avg_depth"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="-- km"
                            style="@style/QW.Text.StatNumber" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Stat 4: Activity Trend -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/QW.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Activity"
                            style="@style/QW.Text.Caption" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/iv_trend_icon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_trending_flat"
                                android:tint="@color/qw_text_secondary"
                                android:contentDescription="@null" />

                            <TextView
                                android:id="@+id/tv_stat_activity"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="Stable"
                                style="@style/QW.Text.StatNumber"
                                android:textSize="18sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </GridLayout>

            <!-- 5. Quick Action Launchpad (Direct Jump to Live Map & Ask AI) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="Explore features"
                style="@style/QW.Text.Label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:orientation="horizontal">

                <!-- Action 1: Epicenter Map -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_action_map"
                    style="@style/QW.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_map"
                            app:tint="@color/qw_primary"
                            android:contentDescription="@null" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/QW.Text.Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Live Map"
                                android:textStyle="bold"
                                android:textSize="14sp" />

                            <TextView
                                style="@style/QW.Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="Epicenters &amp; GPS"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Action 2: Ask AI Guide -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_action_chat"
                    style="@style/QW.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_chat"
                            app:tint="@color/qw_primary"
                            android:contentDescription="@null" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/QW.Text.Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ask AI"
                                android:textStyle="bold"
                                android:textSize="14sp" />

                            <TextView
                                style="@style/QW.Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="Safety guide"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- 6. Earthquake Catalog Section Title -->
            <TextView
                android:id="@+id/tv_catalog_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="Earthquake Catalog"
                style="@style/QW.Text.Label" />

            <!-- 5. Segmented Control: Today, 7 days, 30 days -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggle_time_window"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_window_today"
                    style="@style/QW.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Today" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_window_7d"
                    style="@style/QW.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="7 days" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_window_30d"
                    style="@style/QW.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="30 days" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- 6. Filter Chips: Recent, M4+, M5+, Felt -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_filters"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_recent"
                        style="@style/QW.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Recent" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_m4"
                        style="@style/QW.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="M4+" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_m5"
                        style="@style/QW.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="M5+" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_felt"
                        style="@style/QW.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Felt" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Loading Skeleton Rows (Visible while loading initial data) -->
            <LinearLayout
                android:id="@+id/layout_skeletons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="vertical"
                android:visibility="gone">

                <include layout="@layout/item_quake_skeleton" />
                <include layout="@layout/item_quake_skeleton" />
                <include layout="@layout/item_quake_skeleton" />
            </LinearLayout>

            <!-- Empty State View -->
            <LinearLayout
                android:id="@+id/layout_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="160dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_seismograph_line"
                    android:contentDescription="No earthquakes illustration" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="No earthquakes match these filters"
                    style="@style/QW.Text.Body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_clear_filters"
                    style="@style/QW.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="Clear filters" />
            </LinearLayout>

            <!-- 7. Quake List (RecyclerView) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_quakes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

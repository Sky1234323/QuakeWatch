<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ========== Typography ========== -->

    <style name="QW" />
    <style name="QW.Text" parent="" />

    <!-- Screen title: 28sp serif -->
    <style name="QW.Text.ScreenTitle">
        <item name="android:textSize">@dimen/text_screen_title</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/qw_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Section title: 18sp sans-serif-medium -->
    <style name="QW.Text.SectionTitle">
        <item name="android:textSize">@dimen/text_section_title</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/qw_text_primary</item>
    </style>

    <!-- Body: 15sp sans-serif -->
    <style name="QW.Text.Body">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/qw_text_primary</item>
    </style>

    <!-- Caption: 12sp sans-serif -->
    <style name="QW.Text.Caption">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/qw_text_tertiary</item>
    </style>

    <!-- Body secondary color -->
    <style name="QW.Text.BodySecondary">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/qw_text_secondary</item>
    </style>

    <!-- Big magnitude number: 44sp serif bold -->
    <style name="QW.Text.MagnitudeBig">
        <item name="android:textSize">@dimen/text_magnitude_big</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/qw_on_primary</item>
    </style>

    <!-- Stat number: serif, used for hero numbers -->
    <style name="QW.Text.StatNumber">
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/qw_text_primary</item>
    </style>

    <!-- Label: sans-serif-medium -->
    <style name="QW.Text.Label">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/qw_text_secondary</item>
    </style>

    <!-- ========== Cards ========== -->

    <style name="QW.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardBackgroundColor">@color/qw_surface</item>
        <item name="strokeColor">@color/qw_border</item>
        <item name="strokeWidth">@dimen/card_border</item>
        <item name="contentPadding">@dimen/card_padding</item>
    </style>

    <!-- ========== Buttons ========== -->

    <!-- Primary filled button -->
    <style name="QW.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="backgroundTint">@color/qw_primary</item>
        <item name="android:textColor">@color/qw_on_primary</item>
        <item name="cornerRadius">@dimen/button_radius</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Secondary outlined button -->
    <style name="QW.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/qw_primary</item>
        <item name="strokeColor">@color/qw_border</item>
        <item name="cornerRadius">@dimen/button_radius</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Text button -->
    <style name="QW.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/qw_primary</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- ========== Chips ========== -->

    <style name="QW.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">@dimen/chip_radius</item>
        <item name="chipBackgroundColor">@color/qw_surface_variant</item>
        <item name="chipStrokeColor">@color/qw_border</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/qw_text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="checkedIconVisible">false</item>
    </style>

    <!-- ========== Input ========== -->

    <style name="QW.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/input_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/input_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/input_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/input_radius</item>
        <item name="boxBackgroundColor">@color/qw_surface_variant</item>
        <item name="boxStrokeColor">@color/qw_border</item>
    </style>

    <!-- ========== Bottom Navigation ========== -->

    <style name="QW.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/qw_surface</item>
        <item name="itemActiveIndicatorStyle">@style/QW.BottomNav.Indicator</item>
        <item name="itemIconTint">@color/bottom_nav_icon_color</item>
        <item name="itemTextColor">@color/bottom_nav_icon_color</item>
    </style>

    <style name="QW.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/qw_primary_container</item>
    </style>

</resources>
